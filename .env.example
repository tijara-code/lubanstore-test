# Luban & Musk — environment variables. NAMES ONLY: never commit a value.
# Copy to .env for local development (fake services need none of these).
# Production: Netlify → Site configuration → Environment variables (scope: Functions).
# Meaning of each: docs/ENV.md

# --- core ---
SERVICES_MODE=
# set by Netlify (do not set by hand): SITE_ID, CONTEXT, URL; NODE_ENV=production also means production
SITE_ID=
NODE_ENV=
CONTEXT=
SITE_URL=
DATABASE_URL=
DATA_DIR=
LM_AUTO_SETUP=

# --- admin ---
ADMIN_USER=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=
SESSION_SECRET=

# --- card payments (Thawani) ---
THAWANI_MODE=
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=

# --- fulfilment (Empower / Omniful) ---
OMNIFUL_API_TOKEN=
OMNIFUL_REFRESH_TOKEN=
OMNIFUL_CLIENT_ID=
OMNIFUL_CLIENT_SECRET=
OMNIFUL_HUB_CODE=
OMNIFUL_HOOK_SECRET=
OMNIFUL_ENV=
OMNIFUL_BASE=

# --- tracking ---
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
SNAP_PIXEL_ID=
SNAP_CAPI_TOKEN=
GA4_MEASUREMENT_ID=
GA4_API_SECRET=

# --- build only (npm run build): see docs/ENV.md "Build" ---
LM_BUILD_ID=

# --- tests only (npm run test:pg): a scratch PostgreSQL, never a real database ---
LM_TEST_PG_URL=
